let gw=37.1 gh=58.8 gr=2.6 glass=1.1 dep=7.2 pcb=1.6 so=glass+8.9 bx=14.5 by=21.1 hx=15.24 oy=-0.3 pin=8.64 usbo=1.3 keyx=9.45
plane XY offset=-glass
rect gw gh r=gr
cover: extrude glass
plane XY offset=-(dep-pcb)
rect 35 48.2 at=0,oy r=1
lcd: extrude dep-pcb-glass
plane XY offset=-dep
rect 35 48.2 at=0,oy r=1
pcbb: extrude pcb
plane XY offset=-so
circle 3.36 at=bx,by+oy
circle 3.36 at=-bx,by+oy
circle 3.36 at=bx,-by+oy
circle 3.36 at=-bx,-by+oy
rect 2.54 35 at=hx,oy
rect 2.54 35 at=-hx,oy
rect 11.9 5 at=-0.25,6.3+oy
parts: extrude so-dep
plane XY offset=-(dep+3.26)
rect 8.94 7.35 at=0,oy-24.1-usbo+7.35/2
usb: extrude 3.26
plane XY offset=-(dep+2.8)
rect 8.1 4.4 at=-8.05,-1.1+oy
bat: extrude 2.8
plane XY offset=-(dep+2)
rect 15.1 3.7 at=0.85,-10.05+oy
fpc: extrude 2
plane XY offset=-(dep+pin)
rect 0.64 35 at=hx,oy
rect 0.64 35 at=-hx,oy
pins: extrude pin-(so-dep)
plane XY offset=-(dep-pcb)
bores: hole 2 bx,by+oy -bx,by+oy bx,-by+oy -bx,-by+oy depth=so-dep+pcb
plane XY offset=-(dep+2)
rect 3 3 at=keyx,-24.3+1.5
rect 3 3 at=-keyx,-24.3+1.5
buttons: extrude 2
color #2a5db0
body cam
let camx=0 camy=35.1-25.7-8.5/2-1 lensz=-15.05
plane XY offset=lensz+1.19
rect 8.5 8.5 at=camx,camy
cbody: extrude 3.84
plane XY offset=lensz+1.19
circle 6 at=camx,camy
barrel: extrude -1.19
color #444444
