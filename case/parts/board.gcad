let gw=37.1 gh=58.8 gr=2.6 dep=7.2 pcb=1.6 so=9.7 bx=14.5 by=21.1 hx=15.24
plane XY offset=-(dep-pcb)
rect gw gh r=gr
lcd: extrude dep-pcb
plane XY offset=-dep
rect 35 48.2 r=1
pcbb: extrude pcb
plane XY offset=-so
circle 3.4 at=bx,by
circle 3.4 at=-bx,by
circle 3.4 at=bx,-by
circle 3.4 at=-bx,-by
rect 2.54 35 at=hx,0
rect 2.54 35 at=-hx,0
rect 11.9 5 at=-0.25,6.3
parts: extrude so-dep
plane XY offset=-(dep+3.26)
rect 8.94 7.35 at=0,-20.4
usb: extrude 3.26
plane XY offset=-(dep+4.5)
rect 8.1 4.4 at=-8.05,-1.1
bat: extrude 4.5
plane XY offset=-(dep+2)
rect 15.1 3.7 at=0.85,-10.05
fpc: extrude 2
plane XY offset=-(dep+8)
rect 0.64 35 at=hx,0
rect 0.64 35 at=-hx,0
pins: extrude 8-(so-dep)
plane XY offset=-(dep-pcb)
bores: hole 2 bx,by -bx,by bx,-by -bx,-by depth=so-dep+pcb
color #2a5db0
body cam
plane XY offset=-15.2
rect 8.5 8.5 at=0,8
cbody: extrude 4
plane XY offset=-15.2
circle 6 at=0,8
barrel: extrude -1.4
color #444444
