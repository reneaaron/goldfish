let fs=0.3 my=14 md=0.2 gw=37.1 gh=58.7 gr=2.6 glass=1.1 clr=0.3 t=1.6 dep=7.2 pcb=1.6 hdr=9.2
let ow=gw oh=gh orr=gr top=-glass zb=-(dep+hdr+t) ht=top-zb
let bx=14.5 by=21.1 oy=0 so=glass+8.9 lift=0.4 deep=0.5 sock=3.36 sr=sock/2 rw=0.45 camx=0 camy=4.8+oy lens=6.8 camw=9 rib=0.25
let usbw=13.6 usbz=-(dep+1.63) usbb=usbz-4.1 usbt=-(dep-2.9) pd=oh/2-t-(25.4-oy) pw=usbw+0.8 bk=oh/2-t-(24.1-oy+clr) cvt=-4-clr hw=8.94/2+clr hr=3.26/2+clr
plane XY offset=zb
rect ow oh r=orr
case: extrude ht
fillet 1 case.start&case.side
shell t open=case.end
plane XY offset=zb+t
bosses: boss 6 hdr-lift bx,by+oy -bx,by+oy bx,-by+oy -bx,-by+oy hole=sock+2*rw-0.2 depth=so+deep-dep-lift
plane XY offset=-so-deep-0.3
rect rw 0.6 at=bx+sr+rw/2,by+oy
rect rw 0.6 at=bx-sr-rw/2,by+oy
rect 0.6 rw at=bx,by+oy+sr+rw/2
rect 0.6 rw at=bx,by+oy-sr-rw/2
rect rw 0.6 at=-bx+sr+rw/2,by+oy
rect rw 0.6 at=-bx-sr-rw/2,by+oy
rect 0.6 rw at=-bx,by+oy+sr+rw/2
rect 0.6 rw at=-bx,by+oy-sr-rw/2
rect rw 0.6 at=bx+sr+rw/2,-by+oy
rect rw 0.6 at=bx-sr-rw/2,-by+oy
rect 0.6 rw at=bx,-by+oy+sr+rw/2
rect 0.6 rw at=bx,-by+oy-sr-rw/2
rect rw 0.6 at=-bx+sr+rw/2,-by+oy
rect rw 0.6 at=-bx-sr-rw/2,-by+oy
rect 0.6 rw at=-bx,-by+oy+sr+rw/2
rect 0.6 rw at=-bx,-by+oy-sr-rw/2
sockets: extrude so+deep-dep-lift
plane XY offset=zb+t
rect camw+2 camw+2 at=camx,camy r=1
rect camw camw at=camx,camy r=0.3
camframe: extrude 2
plane XY offset=zb+t
rect 0.6 rib+0.2 at=camx,camy+camw/2-0.05
rect 0.6 rib+0.2 at=camx,camy-camw/2+0.05
rect rib+0.2 0.6 at=camx+camw/2-0.05,camy
rect rib+0.2 0.6 at=camx-camw/2+0.05,camy
ribs: extrude 2
plane case.start
lens: hole lens camx,-camy csink=lens+2*t-0.4,90
plane XY offset=top
rect 35+2*clr 48.2+2*clr at=0,oy r=1
pocket: cut dep-glass+0.2
plane XZ offset=oh/2-t
rect pw top-zb-t at=0,(top+zb+t)/2
port: extrude -pd
plane XZ offset=oh/2-t-pd
rect pw cvt-(zb+t) at=0,(cvt+zb+t)/2
cover: extrude -(bk-pd)
plane XZ offset=oh/2-t-pd
pen -hw,top+1
line -hw,usbz
arc -hw+hr,usbz-hr center=-hw+hr,usbz turn=ccw
line hw-hr,usbz-hr
arc hw,usbz center=hw-hr,usbz turn=ccw
line hw,top+1
close
sockway: cut bk-pd+0.2
plane XZ offset=oh/2
rect usbw usbt-usbb at=0,(usbt+usbb)/2 r=2.5
usb: cut t+pd
chamfer 0.5 usb.side&<Y
plane case.start
rect fs*9 fs*9 at=-fs*-20,my+-fs*-20 r=fs*2
rect fs*9 fs*9 at=-fs*-10,my+-fs*-20 r=fs*2
rect fs*9 fs*9 at=-fs*0,my+-fs*-20 r=fs*2
rect fs*9 fs*9 at=-fs*10,my+-fs*-20 r=fs*2
rect fs*9 fs*9 at=-fs*0,my+-fs*-10 r=fs*2
rect fs*9 fs*9 at=-fs*10,my+-fs*-10 r=fs*2
rect fs*9 fs*9 at=-fs*20,my+-fs*-10 r=fs*2
rect fs*9 fs*9 at=-fs*40,my+-fs*-10 r=fs*2
rect fs*9 fs*9 at=-fs*-40,my+-fs*0 r=fs*2
rect fs*9 fs*9 at=-fs*0,my+-fs*0 r=fs*2
rect fs*9 fs*9 at=-fs*10,my+-fs*0 r=fs*2
rect fs*9 fs*9 at=-fs*20,my+-fs*0 r=fs*2
rect fs*9 fs*9 at=-fs*30,my+-fs*0 r=fs*2
rect fs*9 fs*9 at=-fs*0,my+-fs*10 r=fs*2
rect fs*9 fs*9 at=-fs*10,my+-fs*10 r=fs*2
rect fs*9 fs*9 at=-fs*20,my+-fs*10 r=fs*2
rect fs*9 fs*9 at=-fs*40,my+-fs*10 r=fs*2
rect fs*9 fs*9 at=-fs*-20,my+-fs*20 r=fs*2
rect fs*9 fs*9 at=-fs*-10,my+-fs*20 r=fs*2
rect fs*9 fs*9 at=-fs*0,my+-fs*20 r=fs*2
rect fs*9 fs*9 at=-fs*10,my+-fs*20 r=fs*2
rect fs*29 fs*29 at=-fs*-20,my+-fs*0 r=fs*3
rect fs*19 fs*19 at=-fs*-20,my+-fs*0 r=fs*1.5
rect fs*9 fs*9 at=-fs*-20,my+-fs*0 r=fs*1
mark: cut md
color #1c1c1c
material pla
