let gw=37.1 gh=58.8 gr=2.6 glass=1.1 clr=0.3 t=1.6 dep=7.2 pcb=1.6 hdr=9.2
let ow=gw oh=gh orr=gr top=-glass zb=-(dep+hdr+t) ht=top-zb
let bx=14.5 by=21.1 oy=-0.3 so=glass+8.9 lift=0.4 deep=0.5 sock=3.36 sr=sock/2 rw=0.45 camx=0.4 camy=5.5 lens=6.8 camw=9 rib=0.25 keyx=9.45
plane XY offset=zb
rect ow oh r=orr
case: extrude ht
fillet 1 case.start&case.side
shell t open=case.end
chamfer 0.5 case.end&case.side
plane XY offset=zb+t
bosses: boss 6 hdr-lift bx,by+oy -bx,by+oy bx,-by+oy -bx,-by+oy hole=sock+2*rw-0.2 depth=so+deep-dep-lift
plane XY offset=-so-deep-0.3
rect rw 0.6 at=bx+sr+rw/2,by+oy
rect rw 0.6 at=bx-sr-rw/2,by+oy
rect 0.6 rw at=bx,by+oy+sr+rw/2
rect 0.6 rw at=bx,by+oy-sr-rw/2
rect rw 0.6 at=-bx+sr+rw/2,by+oy
rect rw 0.6 at=-bx-sr-rw/2,by+oy
rect 0.6 rw at=-bx,by+oy+sr+rw/2
rect 0.6 rw at=-bx,by+oy-sr-rw/2
rect rw 0.6 at=bx+sr+rw/2,-by+oy
rect rw 0.6 at=bx-sr-rw/2,-by+oy
rect 0.6 rw at=bx,-by+oy+sr+rw/2
rect 0.6 rw at=bx,-by+oy-sr-rw/2
rect rw 0.6 at=-bx+sr+rw/2,-by+oy
rect rw 0.6 at=-bx-sr-rw/2,-by+oy
rect 0.6 rw at=-bx,-by+oy+sr+rw/2
rect 0.6 rw at=-bx,-by+oy-sr-rw/2
sockets: extrude so+deep-dep-lift
plane XY offset=zb+t
rect camw+2 camw+2 at=camx,camy r=1
rect camw camw at=camx,camy r=0.3
camframe: extrude 2
plane XY offset=zb+t
rect 0.6 rib+0.2 at=camx,camy+camw/2-0.05
rect 0.6 rib+0.2 at=camx,camy-camw/2+0.05
rect rib+0.2 0.6 at=camx+camw/2-0.05,camy
rect rib+0.2 0.6 at=camx-camw/2+0.05,camy
ribs: extrude 2
plane case.start
lens: hole lens camx,-camy
plane XY offset=top
rect 35+2*clr 48.2+2*clr at=0,oy r=1
pocket: cut dep-glass+0.2
plane XZ offset=oh/2
rect 14 8 at=0,-(dep+1.6) r=3.5
usb: cut 2*t
circle 2.6 at=keyx,-(dep+1)
circle 2.6 at=-keyx,-(dep+1)
keys: cut 2*t
color #1c1c1c
material pla
