let gw=37.1 gh=58.8 gr=2.6 clr=0.3 t=1.6 dep=7.2 hdr=9.2 up=0.9 play=0.15
let ow=gw+2*clr+2*t oh=gh+2*clr+2*t orr=gr+clr+t zb=-(dep+hdr+t) ht=dep+hdr+t+up
let bx=14.5 by=21.1 oy=-0.3 so=9.7 camx=0.4 camy=0.5 lens=7.8 camw=8.7 ped=2.4 keyx=9.45
let wi=ow/2-t lw=0.9 tab=20 slot=0.8 sd=12
plane XY offset=zb
rect ow oh r=orr
case: extrude ht
fillet 1 case.start&case.side
shell t open=case.end
chamfer 0.5 case.end&case.side
plane XY offset=zb+t
bosses: boss 4.5 dep+hdr-so bx,by+oy -bx,by+oy bx,-by+oy -bx,-by+oy
plane XY offset=zb+t
rect camw+2 camw+2 at=camx,camy r=1
pedestal: extrude ped
plane XY offset=zb+t+ped
rect camw+2 camw+2 at=camx,camy r=1
rect camw camw at=camx,camy r=0.3
camframe: extrude 1.5
plane case.start
lens: hole lens camx,-camy depth=t+ped
plane XZ offset=oh/2
rect 14 8 at=0,-(dep+1.6) r=3.5
usb: cut 2*t
circle 2.6 at=keyx,-(dep+1)
circle 2.6 at=-keyx,-(dep+1)
keys: cut 2*t
plane XZ offset=-tab/2
poly wi,play wi-lw,play wi-lw,play+0.25 wi-0.15,up-0.05 wi+0.4,up-0.05 wi+0.4,play
poly -wi,play -wi-0.4,play -wi-0.4,up-0.05 -wi+0.15,up-0.05 -wi+lw,play+0.25 -wi+lw,play
ledges: extrude tab
plane XY offset=up
rect t+1 slot at=wi+t/2,tab/2+slot/2
rect t+1 slot at=wi+t/2,-tab/2-slot/2
rect t+1 slot at=-wi-t/2,tab/2+slot/2
rect t+1 slot at=-wi-t/2,-tab/2-slot/2
slots: cut sd
color #1c1c1c
material pla
