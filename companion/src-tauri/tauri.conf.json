{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dove",
  "version": "0.1.0",
  "identifier": "dev.goldfish.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dove",
        "width": 1000,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Finance",
    "shortDescription": "Watch-only wallet for Goldfish"
  }
}
