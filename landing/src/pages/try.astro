---
import Base from "../layouts/Base.astro";
---
<Base title="Try Goldfish in your browser" description="The Goldfish firmware, running in your browser. Scan a test seed, sign a test transaction, read a handwritten backup. No hardware needed." root="../" current="try" caveat>
<style is:global>
  h1 { font-size: clamp(36px, 5.6vw, 52px); letter-spacing: -0.02em; line-height: 1.05; }
  h2 { font-size: 22px; letter-spacing: -0.01em; line-height: 1.2; }
  .lede { color: var(--muted); max-width: 58ch; margin-top: 14px; }

  .intro { padding: 32px 0 0; text-align: center; }
  .intro .lede { margin-left: auto; margin-right: auto; }
  .note {
    display: inline-flex; gap: 10px; align-items: baseline; margin-top: 24px; padding: 10px 16px; text-align: left;
    border: 1px solid var(--line); border-radius: 12px; color: var(--muted); font-size: 15px; max-width: 64ch;
  }
  .note b {                    /* the firmware's TESTNET tag, as on the landing page */
    background: var(--amber-dim); color: var(--amber); font-size: 12px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; padding: 2px 8px; border-radius: 6px; white-space: nowrap;
  }

  /* ---- the device: printed case, black glass, the firmware's screen as a canvas */
  /* things to try | the device | what the camera sees */
  .sim { display: grid; grid-template-columns: 1fr auto 1fr; gap: 56px; align-items: center; padding: 120px 0 0; }
  /* --w (the screen's width) lives on .stage so both the device and the note see it */
  .stage { --w: 360px; display: flex; flex-direction: column; align-items: center; position: relative; }
  /* a hand-drawn note pointing at the screen, like the landing page's hero */
  .tryme { position: absolute; left: -124px; top: -66px; width: 140px; height: 96px; pointer-events: none; overflow: visible; }
  .tryme path { fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .tryme text { font: 700 26px Caveat, "Segoe Print", "Comic Sans MS", cursive; fill: var(--accent); }
  .device {
    width: calc(var(--w) * 1.14); padding-bottom: calc(var(--w) * .05);
    position: relative; flex: none;
    filter: drop-shadow(0 calc(var(--w) * .08) calc(var(--w) * .07) rgba(20, 34, 43, .25));
  }
  .device .glass {
    position: relative; z-index: 1; background: #0B0E10;
    border-radius: calc(var(--w) * .09); padding: calc(var(--w) * .1) calc(var(--w) * .07) calc(var(--w) * .16);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08);
  }
  .device::before {
    content: ""; position: absolute; inset: calc(var(--w) * .05) 0 0 0;
    border-radius: calc(var(--w) * .09); background: var(--case);
    box-shadow: inset 0 calc(var(--w) * -.008) 0 rgba(0, 0, 0, .12);
  }
  canvas {
    display: block; width: 100%; aspect-ratio: 3 / 4; border-radius: calc(var(--w) * .02);
    background: var(--paper); touch-action: none; cursor: pointer;
    image-rendering: pixelated;    /* sharp panel pixels; fit() keeps the scale whole */
  }
  .hint { color: var(--faint); font-size: 14px; margin-top: 16px; min-height: 1.5em; text-align: center; max-width: 36ch; }
  .restart {
    display: none; margin-top: 12px; height: 44px; padding: 0 20px; border: 0; border-radius: 12px;
    background: var(--text); color: var(--bg); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
  }

  /* ---- what the camera sees: the three pictures, stacked */
  .camera h2, .try h2 { font-size: 18px; }
  .camera p { color: var(--muted); font-size: 15px; margin-top: 4px; }
  .shots { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; }
  .shot {
    display: grid; grid-template-columns: 76px 1fr; column-gap: 14px; align-items: center;
    width: 100%; padding: 8px; background: var(--raised); border: 1px solid transparent; border-radius: 14px;
    font: inherit; font-size: 15px; font-weight: 600; color: var(--text); text-align: left; cursor: pointer;
    transition: border-color .15s;
  }
  .shot:hover { border-color: var(--line); }
  .shot[aria-pressed="true"] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .shot img { grid-row: span 2; width: 76px; aspect-ratio: 1; object-fit: contain; background: #fff; border-radius: 10px; }
  .shot small { color: var(--muted); font-size: 13px; font-weight: 400; line-height: 1.35; }

  /* ---- things to try */
  .try ol { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 14px; counter-reset: step; }
  .try li { display: grid; grid-template-columns: 26px 1fr; gap: 12px; align-items: baseline; color: var(--muted); font-size: 15px; }
  .try li::before {
    counter-increment: step; content: counter(step); width: 26px; height: 26px; border-radius: 50%;
    display: grid; place-items: center; font-size: 13px; font-weight: 600; background: var(--raised); color: var(--muted);
  }
  .try b { color: var(--text); font-weight: 600; }

  footer { margin-top: 88px; }

  @media (max-width: 1080px) {
    .sim { gap: 32px; }
    .stage { --w: 300px; }
    .tryme { display: none; }
  }
  /* Narrower: the device on top, the pictures and the steps side by side under it */
  @media (max-width: 900px) {
    .sim { grid-template-columns: 1fr 1fr; gap: 40px 32px; }
    .stage { grid-column: 1 / -1; order: -1; }
    .tryme { display: block; left: auto; right: calc(50% + var(--w) * .6); }
  }
  /* Phones: the screen, then the three pictures in a row right under it, then the steps */
  @media (max-width: 640px) {
    .sim { grid-template-columns: 1fr; gap: 28px; padding-top: 32px; }
    .stage { --w: min(300px, calc(100vw - 96px)); }
    .tryme { display: none; }
    .camera { order: -1; }
    .stage { order: -2; }
    .shots { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .shot { grid-template-columns: 1fr; row-gap: 4px; font-size: 13px; padding: 6px 6px 8px; border-radius: 12px; }
    .shot img { width: 100%; aspect-ratio: 4 / 3; grid-row: auto; border-radius: 8px; }
    .shot small { display: none; }
  }
</style>

<main class="wrap">
  <div class="intro">
    <h1>Try it in your browser</h1>
    <p class="lede">This is the device's own firmware, built for the browser instead of the
      board: the same screens and the same signing code. Tap the screen to use it. In place
      of the camera, pick one of the pictures it should see.</p>
    <p class="note"><b>Demo only</b><span>A browser tab is not a device that forgets. Use the
      test seed here; never type or scan a seed that holds real funds.</span></p>
  </div>

  <div class="sim">
    <section class="try" aria-labelledby="try-title">
      <h2 id="try-title">Things to try</h2>
      <ol>
        <li><span>Tap <b>Scan QR</b> and pick <b>Test seed</b>. The device shows the seed's fingerprint.</span></li>
        <li><span>Tap <b>Scan QR</b> again and pick <b>Transaction</b>. Check the amounts and
          addresses, slide to sign, and the signed transaction comes out as a QR.</span></li>
        <li><span>Under <b>Wallet options</b>, show the xpub for a watch-only wallet.</span></li>
        <li><span>Start over: tap <b>Enter words</b>, choose 24 words, tap the camera
          button and pick <b>Handwritten backup</b>.</span></li>
      </ol>
    </section>

    <div class="stage">
      <svg class="tryme" viewBox="0 0 140 96" aria-hidden="true">
        <text x="4" y="30">try me!</text>
        <path d="M42 42 C 50 64, 72 74, 104 72"/>
        <path d="M93 65 L105 72 L94 80"/>
      </svg>
      <div class="device"><div class="glass">
        <canvas id="screen" width="240" height="320" aria-label="The device's screen"></canvas>
      </div></div>
      <p class="hint" id="status">Loading the firmware…</p>
      <button class="restart" id="restart" type="button">Plug it back in</button>
    </div>

    <section class="camera" aria-labelledby="cam-title">
      <h2 id="cam-title">What the camera sees</h2>
      <p>Pick one while a scan screen is open.</p>
      <ul class="shots">
        <li><button class="shot" type="button" aria-pressed="false" data-src="samples/testseed_height_demise_standard_12word.png">
          <img src="samples/testseed_height_demise_standard_12word.png" alt="">
          Test seed <small>12-word SeedQR</small></button></li>
        <li><button class="shot" type="button" aria-pressed="false" data-src="samples/mainpsbt_height_demise_base64.png">
          <img src="samples/mainpsbt_height_demise_base64.png" alt="">
          Transaction <small>For the test seed, spends a made-up coin</small></button></li>
        <li><button class="shot" type="button" aria-pressed="false" data-src="samples/handwritten_page_demo.png">
          <img src="img/handwritten_page_thumb.jpg" alt="">
          Handwritten backup <small>24 made-up words</small></button></li>
      </ul>
    </section>
  </div>
</main>

<footer slot="footer">
  <div class="wrap">
    <span>Nothing you do here leaves this tab. Close it and the seed is gone.</span>
    <span><a href="../">Goldfish</a> · <a href="https://github.com/reneaaron/goldfish">GitHub</a></span>
  </div>
</footer>

<script is:inline src="signer.js"></script>
<script is:inline>
(() => {
  const canvas = document.getElementById('screen');
  const ctx = canvas.getContext('2d');
  const img = ctx.createImageData(240, 320);
  const status = document.getElementById('status');
  const shots = [...document.querySelectorAll('.shot')];
  let M;

  // ---- screen: RGB565 framebuffer -> canvas
  function onFlush() {
    const fb = new Uint16Array(M.HEAPU16.buffer, M._web_framebuffer(), 240 * 320);
    const px = img.data;
    for (let i = 0, j = 0; i < fb.length; i++, j += 4) {
      const c = fb[i];
      px[j] = ((c >> 11) << 3) | (c >> 13);
      px[j + 1] = (((c >> 5) & 0x3f) << 2) | ((c >> 9) & 3);
      px[j + 2] = ((c & 0x1f) << 3) | ((c >> 2) & 7);
      px[j + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
  }

  // ---- size: a whole number of device pixels per panel pixel, so nothing is
  // smoothed. Nearest to the size the CSS asks for, unless that's much bigger.
  const stage = document.querySelector('.stage');
  function fit() {
    stage.style.removeProperty('--w');
    const want = canvas.getBoundingClientRect().width, dpr = devicePixelRatio || 1;
    let k = Math.max(1, Math.round(want * dpr / 240));
    if (k > 1 && 240 * k / dpr > want * 1.2) k--;
    stage.style.setProperty('--w', 240 * k / dpr + 'px');
  }
  fit();
  addEventListener('resize', fit);   // also fires on browser zoom (devicePixelRatio changes)

  // ---- touch: pointer on the canvas, in screen pixels
  function touch(e, down) {
    if (!M._web_touch) return;
    const r = canvas.getBoundingClientRect();
    const x = Math.max(0, Math.min(239, Math.round((e.clientX - r.left) * 240 / r.width)));
    const y = Math.max(0, Math.min(319, Math.round((e.clientY - r.top) * 320 / r.height)));
    M._web_touch(x, y, down ? 1 : 0);
  }
  let pressed = false;
  canvas.addEventListener('pointerdown', e => { pressed = true; canvas.setPointerCapture(e.pointerId); touch(e, true); });
  canvas.addEventListener('pointermove', e => { if (pressed) touch(e, true); });
  canvas.addEventListener('pointerup', e => { pressed = false; touch(e, false); });
  canvas.addEventListener('pointercancel', e => { pressed = false; touch(e, false); });

  // ---- camera: one grayscale picture at a time, at most 2000 px on its longer side
  const grab = document.createElement('canvas');
  const gctx = grab.getContext('2d', { willReadFrequently: true });
  function feed(source, w, h) {
    const s = Math.min(1, 2000 / Math.max(w, h));
    w = Math.round(w * s); h = Math.round(h * s);
    grab.width = w; grab.height = h;
    gctx.fillStyle = '#fff';
    gctx.fillRect(0, 0, w, h);
    gctx.drawImage(source, 0, 0, w, h);
    const rgba = gctx.getImageData(0, 0, w, h).data;
    const p = M._web_camera_buffer(w, h);
    if (!p) return;
    const gray = new Uint8Array(M.HEAPU8.buffer, p, w * h);
    for (let i = 0, j = 0; i < gray.length; i++, j += 4)
      gray[i] = (rgba[j] * 77 + rgba[j + 1] * 150 + rgba[j + 2] * 29) >> 8;
    M._web_camera_set(w, h);
  }

  function select(el) {
    for (const s of shots) s.setAttribute('aria-pressed', String(s === el));
  }

  async function showImage(url, el) {
    select(el);
    const im = new Image();
    im.src = url;
    try { await im.decode(); } catch { return; }
    feed(im, im.naturalWidth, im.naturalHeight);
  }

  for (const b of shots) if (b.dataset.src) b.addEventListener('click', () => showImage(b.dataset.src, b));

  // ---- start
  const restart = document.getElementById('restart');
  restart.addEventListener('click', () => location.reload());
  // The options object is the module itself: set M now, main() draws before the promise resolves.
  M = {
    onFlush,
    // The device is done looking: take the picture away, as you would a card.
    onCameraStop: () => {
      select(null);
      M._web_camera_clear();
    },
    onReboot: () => {
      status.textContent = 'The device would now restart as a USB drive, to take new firmware.';
      restart.style.display = 'block';
    },
  };
  Signer(M).then(() => {
    status.textContent = 'Tap the screen to use it';
  }).catch(() => { status.textContent = 'This browser could not start the firmware.'; });
})();
</script>
</Base>
